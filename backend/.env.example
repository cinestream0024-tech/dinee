APP_NAME="DINEE Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ledinee.test
FRONTEND_URL=http://ledinee.test
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=single
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dinee
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=ledinee.test,127.0.0.1:5173,localhost:5173
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
DINEE_FOLLOW_UP_DELAY_HOURS=48
# Set a local-only demo password before running DemoSeeder.
DINEE_DEMO_PASSWORD=
